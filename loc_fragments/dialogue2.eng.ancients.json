{
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.ancient": "You've come again. Did you shut the tomb door tight this time?",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.char": "Yes. Tyrfing grumbled a bit.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.ancient": "Even a cursed blade only grumbles at you. How sweet.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-visit": "2",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "How many blades will you bring back this life?",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "I don't bring them. I send them home. Someday.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "Someday... then you'll have to keep rising to keep that word.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-visit": "3",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.ancient": "Gram called your name. In its sleep.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.char": "Swords talk in their sleep?",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.ancient": "A blade long carried grows like its bearer. You talk in your sleep too.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-visit": "5",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.char": "Thanks for waking me every time.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.ancient": "...No one has said that before. Most wake up angry.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2.char": "The blades are waiting. I can't sleep in.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.ancient": "Little gravekeeper, which blade is loudest today?",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.char": "Dainsleif. Always.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.ancient": "Heh. Share a little blessing with that one too.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "7",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "You rose again with that heavy door on your back.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "I'd feel empty without the weight now.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "Then grow as strong as it is heavy.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "7",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.ancient": "I dreamed of ten thousand blades. Every one bore your name.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.char": "...Was it a good dream?",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-2r.ancient": "A good one. Now go make it real.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-visit": "7",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.char": "How far will I get this time?",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.ancient": "As far as your blades lead. And a little further.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-visit": "7",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.ancient": "Oh, gravekeeper! Got that one with the golden hilt?",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.char": "Tyrfing's not for sale. It's even more dangerous for you.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.ancient": "The more dangerous, the more valuable. ...Tch, fine. Take this.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-visit": "2",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "My vault or your tomb—which is fuller?",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "Mine's nowhere near ten thousand.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "Ha! Then I'm still winning.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-visit": "3",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.ancient": "That twin pair—husband and wife, eh? Split up, they'd fetch half.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.char": "Never apart. They have to stay together.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.ancient": "Romantic. A headache for a collector, though.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-visit": "5",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.char": "I'm not selling any blades. Just so you know.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.ancient": "Refusing before I've even said hello!",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2.char": "You ask every time.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-3.ancient": "...Fair enough.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.ancient": "Any room in that tomb? I've got things to store.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.char": "Blades only, I said.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.ancient": "Don't you ever tire of saying that?",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "7",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "The way you look at blades—just like me. A collector's eyes.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "No. A warden's.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "Call it what you like.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "7",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.ancient": "Back again! How many have you collected this time?",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.char": "Don't count them. They hate it.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-2r.ancient": "A collector who doesn't count. Strange one.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-visit": "7",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.ancient": "Let's trade. One of my treasures for one of your...",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.char": "No blades.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-2r.ancient": "...I wasn't even finished.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-visit": "7",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.ancient": "The tide is knocking on your tomb's door. Hear it?",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.char": "I do. The blades are answering.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.ancient": "Sea and steel, talking like old friends.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-visit": "2",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "Rust is the sea's gift to steel. Yet your blades don't rust.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "Because I clean them every day.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "Your care runs deeper than the sea.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-visit": "3",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.ancient": "Blades lie sunk in the deep too. Ones that lost their bearers.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.char": "...Someday I'll come for them too.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.ancient": "Then the tide will open the way.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-visit": "5",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.char": "Why do you always talk about water?",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.ancient": "Because water remembers everything. Your sweat. Your blood.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2.char": "...Then I'd better spill less.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.ancient": "Like pearls in their shells, the blades in your tomb are glowing.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.char": "They're louder than pearls.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.ancient": "Heh. That's nice too.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "7",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "Even at low tide, you stay the same. Like solid rock.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "I'd rather be a blade than a rock.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "Blades rust in water. You don't.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "7",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.ancient": "The waves are calm today. So is your heart.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.char": "Yeah. The blades are quiet.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-2r.ancient": "Then take some of this calm with you.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-visit": "7",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.ancient": "You came again, child with the heavy door.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.char": "Bet it'd be hard to float with this.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-2r.ancient": "If you sink, I'll fish you out.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-visit": "7",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.ancient": "Your blades look like they're drooling over my flesh.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.char": "Just Dainsleif. Sorry.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.ancient": "It's fine. Cute.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-visit": "2",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "You gather blades, I give myself away. Aren't we a little alike?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "...Not at all.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "What a shame.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-visit": "3",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.ancient": "The piece I gave you last time—using it well?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.char": "Yes. It kept me going.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.ancient": "How lovely. Then I'll give you a bigger piece this time.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-visit": "5",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.char": "Doesn't it hurt? Tearing yourself off every time?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.ancient": "It hurts. That's what makes it a gift.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2.char": "...I'll use it with care.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.ancient": "Still no room for my tooth in your tomb?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.char": "Blades only. Still.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.ancient": "So stubborn.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "7",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "What shall I give you today? An eye? A finger?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "Don't make me choose that.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "Heh. Then I'll choose for you.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "7",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.ancient": "I wonder how it feels to be cut. Just once?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.char": "No. My blades aren't for that.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-2r.ancient": "Kind warden. That's why I like you.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-visit": "7",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.ancient": "You came again, warden. What will you take this time?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.char": "Something that doesn't hurt too much.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-2r.ancient": "There's no such thing. But I'll try.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-visit": "7",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.ancient": "Your face is thinner. Are the blades stealing your food?",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.char": "Blades don't eat.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.ancient": "Then why are you so thin? Here, eat this before you go.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-visit": "2",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "I hear a blade called Moye looks after you?",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "Yes. She says the same thing you do. Have I eaten.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "Oh my, I like that blade.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-visit": "3",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.ancient": "More calluses on your hands. All that sword-holding.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.char": "A warden's hands are like this.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.ancient": "Hold a warm bowl now and then.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-visit": "5",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.char": "What have you got for me today?",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.ancient": "Oh my, asking first now! You've grown. Here, take this.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.ancient": "Are your blades behaving? Tell me if they act up.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.char": "Caladbolg's a bit loud.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.ancient": "The big ones always are. Eat this and cheer up.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "7",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "Are you sleeping well? Not up all night guarding that tomb?",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "...Sometimes.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "Not even sometimes. Eat this and go to bed early.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "7",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.ancient": "Hug cold steel all day and your heart goes cold too.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.char": "They're warmer than you'd think.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-2r.ancient": "Are they? Then that's good.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-visit": "7",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.ancient": "My little warden's here! Come, let me see your face.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.char": "You say that every time.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-2r.ancient": "Because I'm glad every time.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-visit": "7",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.ancient": "That Claíomh Solais—it shines rather nicely.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.char": "Don't praise it to its face. It gets cocky.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.ancient": "Beautiful things are allowed to be cocky.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-visit": "2",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "At least wear a cloak. Next to such fancy blades, you look shabby.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "The blades are the stars. I don't mind.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "That modesty is the most unfashionable thing about you.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-visit": "3",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.ancient": "If I tied a ribbon on a cursed blade, would the curse ease?",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.char": "Tyrfing would be furious.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.ancient": "Even fury can be beautiful.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-visit": "5",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.char": "I dressed up a bit today. How is it?",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.ancient": "...Good heavens. All you did was polish the sheaths.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2.char": "That's my best.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.ancient": "Plain as ever. But the blades shine brighter.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.char": "I polish them daily.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.ancient": "Spend even half that care on yourself.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "7",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "A tomb—even the name is gloomy. Why not call it a garden?",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "A sword garden? ...Not bad.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "Right? My taste is never wrong.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "7",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.ancient": "Which of your blades is the prettiest?",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.char": "You can't ask that. They'll fight.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-2r.ancient": "Heh. Beauty always starts quarrels.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-visit": "7",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.ancient": "That outfit again?",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.char": "It's comfortable.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-2r.ancient": "Comfort is the enemy of beauty. Here, at least put this on.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-visit": "7",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.ancient": "Kid! That big blade, Caladbolg was it? Let me swing it!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.char": "No. In your hands, no hill would be left standing.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.ancient": "Hahaha! That's what makes it good!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-visit": "2",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "Weapons are for using! Don't lock them in a tomb!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "I draw them when they're needed. I use them every day.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "Hm! Then I'll allow it!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-visit": "3",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.ancient": "Which of your blades is the fiercest?",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.char": "Dainsleif. You two would get along.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.ancient": "Hahaha! I'd love to spar with it someday!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-visit": "5",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.char": "My turn to ask. Which of your weapons is the strongest?",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.ancient": "Hahaha! All of them!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2.char": "...Same answer as mine.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.ancient": "Kid! More blades again!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.char": "They come and go.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.ancient": "The more weapons the better! Take this too!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "7",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "Still using that broken blade?",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "Broken or not, Gram's the strongest.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "Hahaha! Someone who treasures a broken weapon can be trusted!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "7",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.ancient": "The smell of steel is everywhere! Good, good!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.char": "You always start with that.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-2r.ancient": "Good things deserve saying!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-visit": "7",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.ancient": "Fight me, kid!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.char": "Next time. I have to keep climbing.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-2r.ancient": "Then take this! It'll fight in my place!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-visit": "7",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.ancient": "A cursed blade, a bloodthirsty blade, a blade that refuses masters... ah, your tomb is a library of tragedies.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.char": "They're just swords.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.ancient": "That 'just' is the saddest part.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-visit": "2",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "How will this act end? I'd love one where the warden is devoured by his blades.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "There's no such ending.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "Heh. The audience always wants a twist.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-visit": "3",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.ancient": "When a blade left you, did you weep?",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.char": "...I didn't.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.ancient": "Lies are part of tragedy too. Beautiful.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-visit": "5",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.char": "I won't give you the tragedy you want.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.ancient": "Oh, defiance! That's a fine scene too.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2.char": "...You like anything I do.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.ancient": "My little tragedy, back again. What's this chapter called?",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.char": "'The Warden Climbs Again.'",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.ancient": "Simple, but not bad.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "7",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "When ten thousand blades are gathered, what will you become?",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "Just a warden. Same as now.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "Ah, a protagonist who never changes. That's a tragedy too.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "7",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.ancient": "What song do your blades sing today?",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-0r.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.char": "They're all loud. No harmony.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-1r.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-2r.ancient": "Dissonance! The perfect accompaniment for a tragedy.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.9-visit": "7",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.ancient": "The curtain rises again. Enter the protagonist!",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-0r.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.char": "Skip the applause.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-1r.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-2r.ancient": "Applause doesn't suit tragedy anyway. Take this instead.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.10-visit": "7",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.char": "I'm back. This time every blade is awake.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-0.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.ancient": "Awake blades are dangerous. Especially when they turn on their bearer.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-1.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-2.char": "Mine never turn on me.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.3-attack": "Both",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.ancient": "Gravekeeper. Do you mean to build your tomb taller than my spire?",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-0.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.char": "Height doesn't matter. As long as the blades are comfortable.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-1.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-2.ancient": "...A strange architect.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.4-attack": "Both",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.char": "At the top of your spire, all my blades fell silent.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-0.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.ancient": "Out of fear, no doubt.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-1.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-2.char": "No. Because the end is close.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.5-attack": "Both",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0r.ancient": "Back again. With the broken blade.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-0r.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1r.char": "The broken one lasts the longest.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-1r.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-2r.ancient": "Then prove it.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-visit": "6",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.6-attack": "Both",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.char": "Should I bury a blade in this spire too?",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-0r.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.ancient": "My spire is no tomb.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-1r.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-2r.char": "To my blades, they look alike.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-visit": "6",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.7-attack": "Both",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.ancient": "Gather ten thousand blades, and the spire still has one summit.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-0r.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.char": "Then we'll all go to that summit together.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-1r.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-2r.ancient": "...Come.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-visit": "6",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.8-attack": "Both"
}
