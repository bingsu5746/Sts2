{
  "MAGICSWORDSMAN-SWORD_TALK.AFFINITY_LABEL": "친밀도",
  "MAGICSWORDSMAN-SWORD_TALK.TIER.T0": "경계",
  "MAGICSWORDSMAN-SWORD_TALK.TIER.T1": "익숙",
  "MAGICSWORDSMAN-SWORD_TALK.TIER.T2": "신뢰",
  "MAGICSWORDSMAN-SWORD_TALK.TIER.T3": "각별",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T0.0.A": "또 너냐. 부러진 칼을 휘두르는 애송이.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T0.0.B": "부러져도 칼은 칼이야.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T0.1.A": "시구르드의 손은 이렇게 떨리지 않았다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T0.1.B": "난 시구르드가 아니니까.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.COMBATSTART.T0.0.A": "꺼내라. 무덤 속은 지루하다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.COMBATSTART.T0.0.B": "필요할 때 꺼낼게.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.VICTORY.T0.0.A": "흥. 용 축에도 못 끼는 것들이었다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.VICTORY.T0.0.B": "용이 아니라 다행이지.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.REST.T0.0.A": "불 앞에서 졸지 마라. 방심한 자부터 죽는다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.REST.T0.0.B": "...알았어.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.LOWHP.T0.0.A": "쓰러질 거면 나를 놓고 쓰러져라.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.LOWHP.T0.0.B": "안 쓰러져.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.UPGRADE.T0.0.A": "레긴의 솜씨엔 한참 못 미치는군.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.UPGRADE.T0.0.B": "다음엔 더 잘할게.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T1.0.A": "늦었다. 다음엔 먼저 불러라.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T1.0.B": "그래, 첫 칼은 너야.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T1.1.A": "손목에 힘 빼라. 베는 건 내가 한다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T1.1.B": "그럼 믿어 볼까.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.COMBATSTART.T1.0.A": "냄새가 난다. 오늘은 제법 단단한 놈이다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.COMBATSTART.T1.0.B": "그래서 널 먼저 깨운 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.VICTORY.T1.0.A": "나쁘지 않았다. 아주 조금.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.VICTORY.T1.0.B": "칭찬으로 들을게.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.REST.T1.0.A": "닦을 거면 날부터 닦아라.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.REST.T1.0.B": "알아, 매번 하는 말이잖아.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.LOWHP.T1.0.A": "물러서지 마라. 부러진 건 나 하나로 족하다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.LOWHP.T1.0.B": "...그래, 버틸게.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.UPGRADE.T1.0.A": "이음매가 사라졌다. 좀 하는군.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.UPGRADE.T1.0.B": "레긴만큼은 아니어도.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T2.0.A": "엔시페르, 앞만 봐라. 등은 내가 맡는다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T2.0.B": "고마워, 그람.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T2.1.A": "좋다. 오늘은 네 손이 떨리지 않는군.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T2.1.B": "네가 있으니까.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.COMBATSTART.T2.0.A": "날 먼저 뽑아라. 넌 늘 그래 왔다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.COMBATSTART.T2.0.B": "그래, 늘 그랬지.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.VICTORY.T2.0.A": "봤나? 우리가 벤 거다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.VICTORY.T2.0.B": "응, 우리가.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.REST.T2.0.A": "시구르드도 이렇게 불가에서 칼을 닦았다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.REST.T2.0.B": "그 사람 이야기, 더 해 줘.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.LOWHP.T2.0.A": "정신 차려라! 넌 여기서 끝날 놈이 아니다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.LOWHP.T2.0.B": "...알아. 아직 안 끝났어.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.UPGRADE.T2.0.A": "모루를 쪼개던 시절이 떠오르는군.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.UPGRADE.T2.0.B": "그 시절로 돌려줄게.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T3.0.A": "기다렸다, 엔시페르.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T3.0.B": "나도. 가자, 그람.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T3.1.A": "시구르드보다 네 손이 더 편하다. 놀랍게도.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.SUMMON.T3.1.B": "그 말, 잊지 않을게.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.COMBATSTART.T3.0.A": "부러져도 다시 벼려진다. 우리 둘 다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.COMBATSTART.T3.0.B": "그러니까 두려울 것 없지.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.VICTORY.T3.0.A": "파프니르를 벤 날보다 기분이 좋군.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.VICTORY.T3.0.B": "그건 좀 과장 아니야?",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.REST.T3.0.A": "엔시페르. 다른 검이 다 떠나도 나는 남는다.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.REST.T3.0.B": "알아. 처음부터 너였으니까.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.LOWHP.T3.0.A": "내가 있다. 넌 혼자 쓰러지지 않아.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.LOWHP.T3.0.B": "...그래, 한 번 더.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.UPGRADE.T3.0.A": "이 불꽃, 기억해 두마. 네가 벼린 거니까.",
  "MAGICSWORDSMAN-SWORD_TALK.GRAM.UPGRADE.T3.0.B": "같이 벼린 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T0.0.A": "막야는 어디 있느냐? 막야부터 꺼내라.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T0.0.B": "둘 다 꺼낼게.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T0.0.C": "여기 있어요. 소란 떨지 마세요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T0.1.A": "왕의 칼이 될 바엔 녹아 버리겠다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T0.1.B": "난 왕이 아니야.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.COMBATSTART.T0.0.A": "석 달 안에 만들라더니... 사람들은 늘 서두르지.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.COMBATSTART.T0.0.B": "이번엔 서두르지 않을게.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.VICTORY.T0.0.A": "막야, 다친 데는 없소?",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.VICTORY.T0.0.C": "없어요. 당신이나 조심하세요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T0.0.A": "용광로 불만 못하군.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T0.0.B": "이걸로 참아 줘.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T0.0.A": "꼴사납군. 막야 앞에서 쓰러질 셈이냐.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T0.0.B": "그럴 생각 없어.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.UPGRADE.T0.0.A": "머리카락과 손톱까지 넣은 쇠다. 함부로 두드리지 마라.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.UPGRADE.T0.0.B": "조심히 다룰게.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T1.0.A": "왔군. 막야, 이 녀석 오늘은 좀 낫구려.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T1.0.C": "그러게요. 손이 덜 떨려요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T1.1.A": "베는 건 내가 한다. 막는 건 막야에게 맡겨라.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T1.1.B": "알았어, 역할 분담이지.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.COMBATSTART.T1.0.A": "불 냄새가 난다. 싸움이 가까워.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.COMBATSTART.T1.0.B": "준비됐어?",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.VICTORY.T1.0.A": "봤소, 막야? 내가 먼저 벴소.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.VICTORY.T1.0.C": "네, 네. 대단하세요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T1.0.A": "삼백 아이가 풀무질하던 소리가 그립군.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T1.0.B": "여긴 장작 타는 소리뿐이야.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T1.0.A": "물러서라! 막야와 내가 막는다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T1.0.B": "고마워, 간장.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.UPGRADE.T1.0.A": "쇠가 노래한다. 좋은 망치질이었다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.UPGRADE.T1.0.C": "당신이 칭찬을 다 하네요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T2.0.A": "엔시페르, 막야를 부탁한다. 앞은 내가 연다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T2.0.B": "맡겨.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T2.1.A": "우리 둘을 함께 쓰는 법, 이제 좀 알겠지?",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T2.1.B": "번갈아 쓰면 되잖아.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T2.1.C": "어디 한번 말해 봐요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.COMBATSTART.T2.0.A": "막야, 오늘도 같이 가세.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.COMBATSTART.T2.0.C": "언제나요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.VICTORY.T2.0.A": "좋은 싸움이었다. 네 덕도 있지.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.VICTORY.T2.0.B": "칭찬은 막야한테 해.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T2.0.A": "우리를 만든 부부도 이렇게 불가에 앉아 있곤 했지.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T2.0.B": "행복했겠다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T2.0.C": "불 앞에서는 늘 손을 잡고 있었지요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T2.0.A": "버텨라. 우리를 만든 이들은 3년을 버텼다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T2.0.B": "3년이면... 몇 턴쯤은 버티지.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.UPGRADE.T2.0.A": "막야와 함께 단단해지는구나.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.UPGRADE.T2.0.C": "당신 덕분이에요, 엔시페르.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T3.0.A": "넌 꼭 우리 아들 같구나.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T3.0.B": "...그 말, 좀 쑥스럽네.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T3.1.A": "무엇이든 베어 주마. 우리 셋이면 된다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.SUMMON.T3.1.B": "응, 셋이면 돼.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.COMBATSTART.T3.0.A": "막야, 이 아이를 지키세.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.COMBATSTART.T3.0.C": "말 안 해도 그럴 거예요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.VICTORY.T3.0.A": "하하! 왕의 목을 벨 때보다 개운하군.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.VICTORY.T3.0.B": "그 이야긴 여전히 무섭다니까.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T3.0.A": "엔시페르, 불이 꺼지기 전에 자라. 우리가 지킨다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.REST.T3.0.B": "고마워. 둘 다.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T3.0.A": "널 잃느니 다시 용광로에 들어가겠다!",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T3.0.B": "아무도 안 들어가. 버틸게.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.LOWHP.T3.0.C": "저도요.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.UPGRADE.T3.0.A": "3년 걸렸던 일을 네가 해냈구나.",
  "MAGICSWORDSMAN-SWORD_TALK.GANJIANG.UPGRADE.T3.0.B": "둘이 기다려 준 덕분이야.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T0.0.A": "조심히 다뤄요. 저는 그이만큼 튼튼하지 않아요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T0.0.B": "조심할게요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T0.1.A": "당신이 새 주인인가요? 아직 어리네요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T0.1.B": "주인이 아니라 간수예요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.COMBATSTART.T0.0.A": "간장, 오늘은 무리하지 말아요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.COMBATSTART.T0.0.C": "내가 언제 무리했다고.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.VICTORY.T0.0.A": "다친 데는 없어요? ...없으면 됐어요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.VICTORY.T0.0.B": "괜찮아요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.REST.T0.0.A": "불빛이 따뜻하네요. 용광로는 늘 아팠는데.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.REST.T0.0.B": "여긴 안 아파요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.LOWHP.T0.0.A": "막을게요. 제 뒤로 와요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.LOWHP.T0.0.B": "부탁해요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T0.0.A": "조금 더 단단해졌어요. 고마워요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T0.0.B": "천만에요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T1.0.A": "또 만났네요. 오늘은 얼굴이 좀 폈어요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T1.0.B": "그래 보여?",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T1.1.A": "간장이 먼저 베면, 제가 뒤를 받칠게요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T1.1.C": "그래, 그게 우리 방식이지.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.COMBATSTART.T1.0.A": "숨 고르고 시작해요. 서두를 것 없어요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.COMBATSTART.T1.0.B": "응, 천천히.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.VICTORY.T1.0.A": "잘했어요. 간장, 당신도요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.VICTORY.T1.0.C": "흠, 나야 원래 잘하오.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.REST.T1.0.A": "엔시페르, 밥은 먹었어요?",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.REST.T1.0.B": "...검이 그런 걸 물어?",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.LOWHP.T1.0.A": "얼굴이 창백해요. 제가 막을 테니 숨 돌려요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.LOWHP.T1.0.B": "고마워, 막야.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T1.0.A": "망치 소리가 다정했어요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T1.0.B": "그랬다니 다행이다.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T2.0.A": "부르면 언제든 올게요. 알죠?",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T2.0.B": "알아. 늘 고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T2.1.A": "간장, 이 아이 꽤 믿음직해졌죠?",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T2.1.C": "흥, 아직 멀었소. ...조금은 인정하지.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.COMBATSTART.T2.0.A": "오늘도 셋이서 같이 돌아가요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.COMBATSTART.T2.0.B": "약속할게.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.VICTORY.T2.0.A": "다행이에요. 다들 무사해서.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.VICTORY.T2.0.B": "네가 막아 준 덕분이야.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.REST.T2.0.A": "우리를 만든 부부도 이렇게 웃곤 했어요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.REST.T2.0.B": "좋은 사람들이었구나.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.LOWHP.T2.0.A": "안 돼요, 아직은 안 돼요. 제가 있잖아요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.LOWHP.T2.0.B": "...응. 버틸게.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T2.0.A": "당신 손에서 다시 태어나는 기분이에요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T2.0.B": "둘 다 과장이 심해.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T2.0.C": "아니, 나도 같은 기분이오.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T3.0.A": "당신은 꼭 우리 아이 같아요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T3.0.B": "둘 다 그만해, 쑥스러워.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T3.0.C": "그 말은 내가 먼저 했소.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T3.1.A": "어디든 함께 갈게요. 불 속이라도.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.SUMMON.T3.1.B": "불 속엔 안 데려가.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.COMBATSTART.T3.0.A": "다치지 말아요. 그것만 약속해요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.COMBATSTART.T3.0.B": "약속해.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.VICTORY.T3.0.A": "수고했어요. 오늘 밤은 푹 자요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.VICTORY.T3.0.B": "그래, 고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.REST.T3.0.A": "엔시페르, 언젠가 칼 말고 다른 걸 쥐어 봐요. 꽃 같은 거.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.REST.T3.0.B": "...생각해 볼게.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.LOWHP.T3.0.A": "제가 당신의 방패예요. 끝까지요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.LOWHP.T3.0.B": "막야...",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T3.0.A": "이제 간장 옆에 서도 부끄럽지 않네요.",
  "MAGICSWORDSMAN-SWORD_TALK.MOYE.UPGRADE.T3.0.C": "원래부터 그랬소.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T0.0.A": "삼종신기를 함부로 부르는구나.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T0.0.B": "필요해서 불렀어.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T0.1.A": "두 번이니라. 그 이상은 들어주지 않는다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T0.1.B": "알아. 아껴 쓸게.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.COMBATSTART.T0.0.A": "구름이 무겁구나. 부정한 것이 가깝다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.COMBATSTART.T0.0.B": "그래서 깨웠어.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.VICTORY.T0.0.A": "더러운 것은 걷혔다. 너도 씻어라.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.VICTORY.T0.0.B": "...알았어.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.REST.T0.0.A": "들불 속에서 풀을 베던 밤도 이리 고요했느니라.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.REST.T0.0.B": "여긴 불이 번지지 않아.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.LOWHP.T0.0.A": "꼴이 말이 아니구나. 스사노오라면 웃었을 것이다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.LOWHP.T0.0.B": "웃을 일 아니야.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.UPGRADE.T0.0.A": "신기를 다룰 손은 아니나... 정성은 알겠다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.UPGRADE.T0.0.B": "그거면 충분해.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T1.0.A": "또 나를 찾는구나. 싫지는 않다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T1.0.B": "그럼 다행이고.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T1.1.A": "앞의 검의 힘, 반쯤은 이어 주마.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T1.1.B": "고마워, 쿠사나기.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.COMBATSTART.T1.0.A": "바람이 바뀌었다. 칼을 쥘 때다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.COMBATSTART.T1.0.B": "응, 준비됐어.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.VICTORY.T1.0.A": "깨끗하구나. 네 칼질도 조금은.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.VICTORY.T1.0.B": "조금은, 이라.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.REST.T1.0.A": "구름이 걷히면 별이 보이느니라. 쉬어라.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.REST.T1.0.B": "응. 너도.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.LOWHP.T1.0.A": "부정이 몸에 스몄다. 내가 걷어 내마.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.LOWHP.T1.0.B": "부탁해.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.UPGRADE.T1.0.A": "칼끝에 구름이 모인다. 나쁘지 않구나.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.UPGRADE.T1.0.B": "옛 모습에 좀 가까워졌어?",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T2.0.A": "부르거라. 너라면 두 번이 아깝지 않다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T2.0.B": "그렇게 말해 줘서 고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T2.1.A": "엔시페르, 오늘의 바람은 네 편이다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T2.1.B": "너도 내 편이고.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.COMBATSTART.T2.0.A": "하늘의 구름이 너를 위해 모이는구나.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.COMBATSTART.T2.0.B": "든든하다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.VICTORY.T2.0.A": "잘 베었다. 스사노오에게 자랑하고 싶을 정도다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.VICTORY.T2.0.B": "그 사람이 질투하겠는데.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.REST.T2.0.A": "신기도 지칠 때가 있느니라. 오늘은 곁에 두어라.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.REST.T2.0.B": "그래, 여기 있어.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.LOWHP.T2.0.A": "물러서지 마라. 들불 속에서처럼 내가 길을 내겠다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.LOWHP.T2.0.B": "믿을게.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.UPGRADE.T2.0.A": "'풀을 벤 검'이라는 이름이 다시 어울리는구나.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.UPGRADE.T2.0.B": "원래 네 이름이잖아.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T3.0.A": "두 번이라는 약조가 너에게만은 아쉽구나.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T3.0.B": "두 번이면 충분해. 넌 확실하니까.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T3.1.A": "신기가 섬길 주인은 아니다. 허나 벗으로는 족하다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.SUMMON.T3.1.B": "벗이면 충분해.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.COMBATSTART.T3.0.A": "엔시페르. 오늘도 함께 길을 내자.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.COMBATSTART.T3.0.B": "응, 같이.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.VICTORY.T3.0.A": "후후. 하늘이 맑구나. 네 덕이다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.VICTORY.T3.0.B": "네 덕이지.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.REST.T3.0.A": "옛 주인들보다 네 곁이 편하구나. 이상한 일이다.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.REST.T3.0.B": "이상할 거 없어.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.LOWHP.T3.0.A": "내가 너를 씻어 내마. 쓰러지지 마라, 벗이여.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.LOWHP.T3.0.B": "...그래, 아직이야.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.UPGRADE.T3.0.A": "이 칼날, 너에게 바치마.",
  "MAGICSWORDSMAN-SWORD_TALK.KUSANAGI.UPGRADE.T3.0.B": "바치지 말고 같이 가.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T0.0.A": "뽑았군. 이제 누군가 죽는다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T0.0.B": "그러려고 뽑았어.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T0.1.A": "황금 자루를 쥔 자들은 다 끝이 나빴다. 너도 그럴 거다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T0.1.B": "두고 보면 알겠지.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.COMBATSTART.T0.0.A": "날 뽑고 싶어 손이 근질거리나?",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.COMBATSTART.T0.0.B": "아니. 꼭 필요할 때만.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.VICTORY.T0.0.A": "이겼지. 나는 늘 이기게 해 준다. 대가는 나중이다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.VICTORY.T0.0.B": "알고 있어.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.REST.T0.0.A": "불을 쬐어도 내 칼날은 차갑다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.REST.T0.0.B": "그래도 옆에 둘게.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.LOWHP.T0.0.A": "이대로 죽으면 저주도 너와 함께 끝나겠군.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.LOWHP.T0.0.B": "그 저주, 내가 지고 갈 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.UPGRADE.T0.0.A": "날카로워질수록 저주도 깊어진다. 그래도 하겠나?",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.UPGRADE.T0.0.B": "알고 하는 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T1.0.A": "또냐. 넌 겁도 없군.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T1.0.B": "겁나. 그래도 써야지.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T1.1.A": "빗나가진 않는다. 그게 내 유일한 미덕이지.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T1.1.B": "그거면 돼.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.COMBATSTART.T1.0.A": "드발린의 저주가 들끓는다. 오늘은 조심해라.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.COMBATSTART.T1.0.B": "경고해 주는 거야?",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.VICTORY.T1.0.A": "...이번엔 네가 아니라 다행이군.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.VICTORY.T1.0.B": "걱정해 준 거야?",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.REST.T1.0.A": "녹슬지 않는 칼은 쉴 줄도 모른다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.REST.T1.0.B": "그럼 내가 대신 쉴게.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.LOWHP.T1.0.A": "멍청하긴. 날 쥔 놈이 먼저 죽으면 꼴이 뭐가 되나.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.LOWHP.T1.0.B": "안 죽어.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.UPGRADE.T1.0.A": "불꽃 칼날이 다시 타오른다. ...고맙다고는 안 한다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.UPGRADE.T1.0.B": "안 해도 돼.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T2.0.A": "엔시페르. 저주는 내가 감당한다. 넌 베기만 해.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T2.0.B": "반씩 나누자.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T2.1.A": "앙간튀르도 너만큼 날 아끼진 않았다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T2.1.B": "아끼는 게 아니라 믿는 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.COMBATSTART.T2.0.A": "필요하면 뽑아라. 망설이다 죽는 것보단 낫다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.COMBATSTART.T2.0.B": "그래, 망설이지 않을게.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.VICTORY.T2.0.A": "또 이겼다. 이번 대가는... 내가 치르지.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.VICTORY.T2.0.B": "그런 말 하지 마.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.REST.T2.0.A": "저주받은 칼 옆에서 잘도 자는군, 넌.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.REST.T2.0.B": "넌 날 해치지 않을 테니까.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.LOWHP.T2.0.A": "안 된다. 이번에 죽는 건 네가 아니다.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.LOWHP.T2.0.B": "티르빙...",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.UPGRADE.T2.0.A": "쇠와 돌을 베던 날로 돌아가는군. 이번엔 좋은 일에 쓰이길.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.UPGRADE.T2.0.B": "그렇게 할게.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T3.0.A": "세 번의 악행은 내가 짊어지마. 넌 깨끗하게 남아라.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T3.0.B": "같이 짊어지자고 했잖아.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T3.1.A": "나는 언제나 승리를 준다. 이번엔 진심으로 주고 싶군.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.SUMMON.T3.1.B": "기꺼이 받을게.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.COMBATSTART.T3.0.A": "엔시페르. 날 뽑아도 괜찮다. 너라면.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.COMBATSTART.T3.0.B": "고마워, 티르빙.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.VICTORY.T3.0.A": "죽은 건 적뿐이다. 처음으로 저주가 비껴갔군.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.VICTORY.T3.0.B": "앞으로도 그럴 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.REST.T3.0.A": "드발린도 이런 주인은 상상하지 못했겠지.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.REST.T3.0.B": "나도 이런 검은 상상 못 했어.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.LOWHP.T3.0.A": "저주여, 들어라. 이 녀석만은 데려가지 마라.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.LOWHP.T3.0.B": "...버틸게. 네 부탁이니까.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.UPGRADE.T3.0.A": "언제나 이기는 칼이 되겠다. 오직 너를 위해서.",
  "MAGICSWORDSMAN-SWORD_TALK.TYRFING.UPGRADE.T3.0.B": "같이 이기자.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T0.0.A": "피 냄새! 드디어 꺼내 주는구나!",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T0.0.B": "적당히 해.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T0.1.A": "한 번 뽑힌 이상, 피를 보기 전엔 안 들어간다.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T0.1.B": "알아. 그래서 조심히 뽑은 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.COMBATSTART.T0.0.A": "싸움이다, 싸움! 끝나지 않는 싸움!",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.COMBATSTART.T0.0.B": "끝낼 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.VICTORY.T0.0.A": "벌써 끝? 아직 목마른데.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.VICTORY.T0.0.B": "다음에 또 있어.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.REST.T0.0.A": "쉬기 싫어. 회그니는 밤새 싸웠다고.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.REST.T0.0.B": "난 회그니가 아니야.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.LOWHP.T0.0.A": "네 피는 맛보고 싶지 않은데... 아직은.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.LOWHP.T0.0.B": "영원히 맛보지 마.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.UPGRADE.T0.0.A": "더 날카롭게! 더 깊게!",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.UPGRADE.T0.0.B": "진정해.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T1.0.A": "기다렸어. 오늘은 누굴 벨까?",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T1.0.B": "저기 있는 것들.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T1.1.A": "방패 따윈 버려. 나만 있으면 돼.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T1.1.B": "그게 네 대가지.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.COMBATSTART.T1.0.A": "심장 뛰는 소리가 들려. 네 것도, 저것들 것도.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.COMBATSTART.T1.0.B": "내 건 듣지 마.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.VICTORY.T1.0.A": "흐흐, 좋았어. 다음엔 더 오래 싸우자.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.VICTORY.T1.0.B": "짧을수록 좋아.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.REST.T1.0.A": "칼집이 답답해. 조금만 더 밖에 있을래.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.REST.T1.0.B": "그럼 불 옆에 있어.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.LOWHP.T1.0.A": "다쳤어? 그럼 저놈들 피로 갚아 주자.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.LOWHP.T1.0.B": "그래, 갚아 주자.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.UPGRADE.T1.0.A": "이제 내가 낸 상처는 더 깊어지겠지.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.UPGRADE.T1.0.B": "적한테만이야.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T2.0.A": "엔시페르! 너랑 싸우는 게 제일 재밌어.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T2.0.B": "그 말이 좀 무섭다.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T2.1.A": "걱정 마. 네 피는 안 마셔. 약속할게.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T2.1.B": "고마워. 진심이지?",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.COMBATSTART.T2.0.A": "끝없는 싸움도 너랑이면 나쁘지 않아.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.COMBATSTART.T2.0.B": "그래도 오늘은 끝내자.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.VICTORY.T2.0.A": "봤어? 하나도 안 남겼어!",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.VICTORY.T2.0.B": "응, 잘했어.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.REST.T2.0.A": "이상하지. 요즘은 칼집 안도 그렇게 싫지 않아.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.REST.T2.0.B": "익숙해진 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.LOWHP.T2.0.A": "누가 네 피를 흘리게 했어? 다 베어 버릴 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.LOWHP.T2.0.B": "그래, 같이 가자.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.UPGRADE.T2.0.A": "네가 벼려 주면 덜 목마른 것 같아.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.UPGRADE.T2.0.B": "다행이다.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T3.0.A": "네가 부르면 피 냄새보다 먼저 달려와.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T3.0.B": "그거 칭찬이지?",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T3.1.A": "회그니보다 네가 좋아. 회그니는 날 아낀 적이 없거든.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.SUMMON.T3.1.B": "난 아낄 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.COMBATSTART.T3.0.A": "이번 싸움도 끝내 줄게. 너를 위해서라면.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.COMBATSTART.T3.0.B": "고마워, 다인슬레이프.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.VICTORY.T3.0.A": "피 맛보다 네 칭찬이 더 좋아. 해 줘.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.VICTORY.T3.0.B": "잘했어. 정말로.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.REST.T3.0.A": "오늘은 그냥 칼집에 들어갈게. 피 안 봐도 괜찮아.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.REST.T3.0.B": "...많이 변했네.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.LOWHP.T3.0.A": "네 피만은 안 돼. 절대로!",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.LOWHP.T3.0.B": "그래, 안 흘릴게.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.UPGRADE.T3.0.A": "끝나지 않는 싸움이라도 너와 함께라면 좋아.",
  "MAGICSWORDSMAN-SWORD_TALK.DAINSLEIF.UPGRADE.T3.0.B": "끝나는 싸움으로 하자.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T0.0.A": "부르셨습니까. 이 검은 신앙을 위해 휘두르는 것입니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T0.0.B": "지키기 위해 휘두를 거야.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T0.1.A": "롤랑이 바위에 열 번을 내리쳐도 저는 꺾이지 않았습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T0.1.B": "꺾을 생각 없어.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.COMBATSTART.T0.0.A": "자루 속 성유물이 떨립니다. 악이 가깝습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.COMBATSTART.T0.0.B": "그럼 지켜 줘.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.VICTORY.T0.0.A": "주께 감사를. 그리고 당신에게도, 조금은.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.VICTORY.T0.0.B": "조금이라도 고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.REST.T0.0.A": "기도를 드리겠습니다. 당신 몫까지.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.REST.T0.0.B": "고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.LOWHP.T0.0.A": "지금은 저를 쥘 수 없습니다. 그래도 곁에서 기도하겠습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.LOWHP.T0.0.B": "그거면 돼.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.UPGRADE.T0.0.A": "흠집 없는 칼날에 손을 대시다니. ...그래도 정성은 느껴집니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.UPGRADE.T0.0.B": "흠집은 안 냈어.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T1.0.A": "다시 뵙습니다, 젊은 간수여.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T1.0.B": "반가워, 뒤랑달.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T1.1.A": "제 뒤에 서십시오. 막는 것은 제 일입니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T1.1.B": "믿을게.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.COMBATSTART.T1.0.A": "샤를마뉴의 깃발이 떠오릅니다. 당당히 나아가십시오.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.COMBATSTART.T1.0.B": "응, 당당하게.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.VICTORY.T1.0.A": "훌륭했습니다. 롤랑도 칭찬했을 겁니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.VICTORY.T1.0.B": "롤랑은 엄했을 것 같은데.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.REST.T1.0.A": "불 앞에서는 모두가 평등하지요. 성자도, 간수도.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.REST.T1.0.B": "칼도?",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.LOWHP.T1.0.A": "물러나 숨을 고르십시오. 다시 저를 쥘 때가 옵니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.LOWHP.T1.0.B": "알았어. 조금만 기다려.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.UPGRADE.T1.0.A": "성유물이 따뜻해졌습니다. 축복받은 망치질이었습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.UPGRADE.T1.0.B": "축복까진 모르겠는데.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T2.0.A": "당신을 지키는 것이 이제 제 신앙입니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T2.0.B": "무거운 말이네.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T2.1.A": "부서지지 않는 것은 저만이 아닙니다. 당신도 그렇습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T2.1.B": "...고마워, 뒤랑달.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.COMBATSTART.T2.0.A": "기도는 끝났습니다. 이제 함께 싸우지요.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.COMBATSTART.T2.0.B": "같이 가자.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.VICTORY.T2.0.A": "단 한 번도 물러서지 않으셨군요. 자랑스럽습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.VICTORY.T2.0.B": "네가 막아 줬으니까.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.REST.T2.0.A": "롤랑은 마지막에 저를 부수려 했습니다. 적에게 넘기지 않으려고요.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.REST.T2.0.B": "그런 일은 없게 할게.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.LOWHP.T2.0.A": "제 손이 닿지 않는 곳에 계시는군요. 부디 돌아오십시오.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.LOWHP.T2.0.B": "돌아갈게. 꼭.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.UPGRADE.T2.0.A": "흠집 없는 칼, 이제는 당신의 칼입니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.UPGRADE.T2.0.B": "우리의 칼이지.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T3.0.A": "벗이여, 오늘도 당신 앞에 서겠습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T3.0.B": "언제나 고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T3.1.A": "천사가 저를 세상에 내려준 까닭을, 이제야 알 것 같습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.SUMMON.T3.1.B": "무슨 까닭인데?",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.COMBATSTART.T3.0.A": "어떤 악도 당신에게 닿지 못합니다. 제가 있는 한.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.COMBATSTART.T3.0.B": "든든하다, 뒤랑달.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.VICTORY.T3.0.A": "주께, 그리고 당신에게. 이번엔 똑같이 감사드립니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.VICTORY.T3.0.B": "하하, 나도 승격됐네.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.REST.T3.0.A": "당신의 잠을 지키는 것보다 거룩한 임무는 없습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.REST.T3.0.B": "그럼 부탁할게.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.LOWHP.T3.0.A": "쥘 수 없어도 저는 여기 있습니다. 끝까지.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.LOWHP.T3.0.B": "알아. 느껴져.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.UPGRADE.T3.0.A": "롤랑의 검이 아니라, 엔시페르의 검으로 불리고 싶습니다.",
  "MAGICSWORDSMAN-SWORD_TALK.DURANDAL.UPGRADE.T3.0.B": "그 이름, 잘 어울려.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T0.0.A": "무덤을 깨운 자가 누구냐. ...애송이로군.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T0.0.B": "만검총의 간수야.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T0.1.A": "우리 열둘이 지켜보고 있다. 실망시키지 마라.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T0.1.B": "실망 안 시킬게.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.COMBATSTART.T0.0.A": "자루에 햇빛이 닿게 하지 마라. 첫 칼은 기다려라.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.COMBATSTART.T0.0.B": "알아, 금기잖아.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.VICTORY.T0.0.A": "흐롤프 왕의 적들은 더 강했다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.VICTORY.T0.0.B": "그럼 다음엔 더 센 놈을 찾아볼까.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.REST.T0.0.A": "불은 좋다. 해는 싫다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.REST.T0.0.B": "밤이라 다행이네.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.LOWHP.T0.0.A": "피를 흘리는구나. 광전사라면 웃었을 것이다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.LOWHP.T0.0.B": "웃을 여유 없어.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.UPGRADE.T0.0.A": "열두 혼이 웅성거린다. 네 망치질을 지켜봤다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.UPGRADE.T0.0.B": "평가는?",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T1.0.A": "우리 열둘 중 셋쯤은 너를 인정하기 시작했다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T1.0.B": "나머지 아홉은?",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T1.1.A": "베어라. 상처는 우리가 새긴다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T1.1.B": "맡길게.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.COMBATSTART.T1.0.A": "무덤 냄새가 난다. 우리 무덤 말고, 저놈들 것.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.COMBATSTART.T1.0.B": "그럼 만들어 주자.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.VICTORY.T1.0.A": "열둘이 함께 소리친다. 좋은 싸움이었다!",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.VICTORY.T1.0.B": "들려. 엄청 시끄럽게.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.REST.T1.0.A": "흐롤프 왕의 연회도 이렇게 불가에서 열렸다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.REST.T1.0.B": "술이 없어서 미안.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.LOWHP.T1.0.A": "일어나라! 왕의 광전사들은 무릎 꿇지 않았다!",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.LOWHP.T1.0.B": "...그래, 일어날게.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.UPGRADE.T1.0.A": "칼날이 다시 북방의 추위를 기억한다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.UPGRADE.T1.0.B": "좋은 거지?",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T2.0.A": "열둘 모두가 너를 왕이라 부르자고 한다. ...거절했다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T2.0.B": "잘했어. 왕은 싫어.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T2.1.A": "우리 혼이 네 등을 받친다. 겁내지 마라.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T2.1.B": "고마워, 스코프눙.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.COMBATSTART.T2.0.A": "해가 지기를 기다리듯 첫 턴만 참아라. 그다음은 우리 차례다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.COMBATSTART.T2.0.B": "알아. 기다릴게.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.VICTORY.T2.0.A": "열둘이 네 이름을 외친다. 엔시페르!",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.VICTORY.T2.0.B": "그만해, 쑥스러워.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.REST.T2.0.A": "무덤 속은 춥고 조용했다. 네 곁은 시끄럽고 따뜻하군.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.REST.T2.0.B": "싫어?",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.LOWHP.T2.0.A": "왕을 지키던 때처럼 너를 지키겠다. 열둘 모두가!",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.LOWHP.T2.0.B": "든든하다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.UPGRADE.T2.0.A": "북방 최고의 검이라는 이름, 너 덕에 되찾는다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.UPGRADE.T2.0.B": "원래 네 이름이야.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T3.0.A": "열둘이 한목소리로 말한다. 너는 우리의 열세 번째다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T3.0.B": "...영광이야.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T3.1.A": "흐롤프 왕 이후 처음이다. 기꺼이 뽑히는 것은.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.SUMMON.T3.1.B": "기꺼이 와 줘서 고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.COMBATSTART.T3.0.A": "햇빛이 와도 괜찮다. 네가 그늘이 되어 줄 테니.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.COMBATSTART.T3.0.B": "그래, 가려 줄게.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.VICTORY.T3.0.A": "형제여, 오늘도 이겼다!",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.VICTORY.T3.0.B": "응, 형제들.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.REST.T3.0.A": "왕의 무덤으로 돌아갈 필요는 없겠군. 우리 자리는 여기다.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.REST.T3.0.B": "언제까지든 여기 있어.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.LOWHP.T3.0.A": "열셋 중 누구도 쓰러지게 두지 않는다!",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.LOWHP.T3.0.B": "그래, 아무도 안 쓰러져.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.UPGRADE.T3.0.A": "열두 광전사의 이름을 걸고, 이 칼날을 너에게.",
  "MAGICSWORDSMAN-SWORD_TALK.SKOFNUNG.UPGRADE.T3.0.B": "소중히 쓸게.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T0.0.A": "......오니의 기척.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T0.0.B": "그래. 부탁해.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T0.1.A": "주인은 필요 없다. 나는 혼자 벤다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T0.1.B": "알아. 그래도 같이 있자.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T0.0.A": "......끝났다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T0.0.B": "수고했어.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T0.1.A": "베어야 할 것을 벴을 뿐.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.REST.T0.0.A": "......",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.REST.T0.0.B": "말 안 해도 돼. 같이 쉬자.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.LOWHP.T0.0.A": "물러나라. 내가 벤다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.LOWHP.T0.0.B": "...고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.UPGRADE.T0.0.A": "......나쁘지 않다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.UPGRADE.T0.0.B": "다행이다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T1.0.A": "오늘은 네 곁에서 벤다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T1.0.B": "든든해.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T1.1.A": "명령해라. 들어는 주마.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T1.1.B": "그럼 저 녀석부터.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T1.0.A": "......네 칼질, 조금 늘었다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T1.0.B": "오니마루한테 칭찬을 다 듣네.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T1.1.A": "다친 데는.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T1.1.B": "없어. 네 덕분에.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.REST.T1.0.A": "자라. 내가 지킨다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.REST.T1.0.B": "고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.LOWHP.T1.0.A": "......누가 너를.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.LOWHP.T1.0.B": "괜찮아. 아직 버틸 수 있어.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.UPGRADE.T1.0.A": "칼날이 맑아졌다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.UPGRADE.T1.0.B": "오니가 더 잘 보이겠네.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T2.0.A": "엔시페르. 내가 먼저 나간다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T2.0.B": "응. 뒤는 내가 볼게.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T2.1.A": "스스로 움직일 이유가 생겼다. 너다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T2.1.B": "...그 말, 고마워.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T2.0.A": "......호흡이 좋았다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T2.0.B": "우리 잘 맞지?",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T2.1.A": "다섯 자루 중 으뜸이라 했지. 오늘은 그 말이 맞았다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T2.1.B": "넌 늘 으뜸이야.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.REST.T2.0.A": "불 옆이 따뜻하다는 걸, 너에게서 배웠다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.REST.T2.0.B": "...다행이다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.LOWHP.T2.0.A": "네게 손대는 것은 오니든 사람이든 벤다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.LOWHP.T2.0.B": "믿을게, 오니마루.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.UPGRADE.T2.0.A": "......고맙다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.UPGRADE.T2.0.B": "방금 고맙다고 한 거야?",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T3.0.A": "주인은 필요 없다고 했지. ...너는 예외다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T3.0.B": "영광이야.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T3.1.A": "부르지 않아도 온다. 언제나.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.COMBATSTART.T3.1.B": "알아. 그래서 마음이 놓여.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T3.0.A": "네가 무사하면 됐다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T3.0.B": "너도 무사해서 다행이야.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T3.1.A": "......웃어라. 이겼으니.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.VICTORY.T3.1.B": "오니마루가 그런 말을 다 하네.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.REST.T3.0.A": "잠들 때까지 여기 있겠다. 잠든 뒤에도.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.REST.T3.0.B": "고마워. 잘 자, 오니마루.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.LOWHP.T3.0.A": "물러나지 마라. 이번엔 내가 너의 손이 된다.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.LOWHP.T3.0.B": "...그래. 같이 베자.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.UPGRADE.T3.0.A": "더 날카로워졌다. 너를 지키기에 충분할 만큼.",
  "MAGICSWORDSMAN-SWORD_TALK.ONIMARU.UPGRADE.T3.0.B": "넌 원래 충분했어.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T0.0.A": "어둠 속에 오래도 가둬 뒀군. 눈부시지?",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T0.0.B": "조금.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T0.1.A": "턴을 마칠 때 다른 검을 들고 있으면 내 빛은 꺼진다. 기억해.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T0.1.B": "기억할게.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.COMBATSTART.T0.0.A": "어둡군. 이럴 때 날 안 부르면 언제 부르나.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.COMBATSTART.T0.0.B": "때가 되면.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.VICTORY.T0.0.A": "빛 앞에서 버틸 것은 없다.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.VICTORY.T0.0.B": "그래, 눈부셨어.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.REST.T0.0.A": "모닥불이라... 나에 비하면 촛불이군.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.REST.T0.0.B": "따뜻한 건 이쪽이야.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.LOWHP.T0.0.A": "내가 뽑히면 누구도 벗어나지 못했는데. 지금 지고 있는 건 너로군.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.LOWHP.T0.0.B": "아직 안 졌어.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.UPGRADE.T0.0.A": "더 밝게! 누아다의 횃불답게!",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.UPGRADE.T0.0.B": "눈 아파.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T1.0.A": "기다리는 동안 빛을 모아 뒀어. 칭찬해도 돼.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T1.0.B": "잘했어.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T1.1.A": "턴을 마칠 땐 날 들고 있어. 그래야 빛이 쌓여.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T1.1.B": "알았어, 약속.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.COMBATSTART.T1.0.A": "핀디아스의 빛을 보여 줄 시간이야.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.COMBATSTART.T1.0.B": "기대할게.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.VICTORY.T1.0.A": "흐음, 오늘 빛은 꽤 아름다웠지?",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.VICTORY.T1.0.B": "응, 예뻤어.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.REST.T1.0.A": "밤엔 나도 조금 흐려져. 비밀이야.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.REST.T1.0.B": "지켜 줄게.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.LOWHP.T1.0.A": "눈 감지 마. 내 빛이 보여야 해.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.LOWHP.T1.0.B": "보여. 아직 보여.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.UPGRADE.T1.0.A": "네 망치에서 별이 튀었어. 마음에 들어.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.UPGRADE.T1.0.B": "다행이다.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T2.0.A": "엔시페르, 네 손에 있을 때 내 빛이 제일 밝아.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T2.0.B": "기분 좋은 말이네.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T2.1.A": "다른 검으로 바꿔도 돼. 대신 마지막엔 꼭 돌아와.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T2.1.B": "꼭 돌아올게.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.COMBATSTART.T2.0.A": "어둠이 아무리 짙어도 우리가 있으면 낮이야.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.COMBATSTART.T2.0.B": "멋진 말이다.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.VICTORY.T2.0.A": "너랑 같이 빛나니까 두 배로 밝더라.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.VICTORY.T2.0.B": "난 빛 안 나는데.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.REST.T2.0.A": "불빛에 비친 네 얼굴, 꽤 괜찮은데.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.REST.T2.0.B": "갑자기 왜 그래.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.LOWHP.T2.0.A": "내 빛을 다 써도 좋아. 너만 일어나.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.LOWHP.T2.0.B": "아껴 둬. 일어날 거니까.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.UPGRADE.T2.0.A": "누아다도 이렇게 정성 들여 닦아 주진 않았어.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.UPGRADE.T2.0.B": "그럼 내가 일등이네.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T3.0.A": "부르는 목소리만 들어도 환해져.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T3.0.B": "나도 너를 보면 그래.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T3.1.A": "누구도 벗어나지 못하는 빛이, 이제는 너를 지키는 빛이야.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.SUMMON.T3.1.B": "고마워, 솔라시.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.COMBATSTART.T3.0.A": "가자, 엔시페르. 오늘도 눈부시게.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.COMBATSTART.T3.0.B": "응, 눈부시게.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.VICTORY.T3.0.A": "봤지? 우리 둘이면 밤도 낮이 돼.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.VICTORY.T3.0.B": "그래, 봤어.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.REST.T3.0.A": "오늘 밤은 내가 불 대신 밝혀 줄게. 푹 자.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.REST.T3.0.B": "고마워. 너무 밝게는 말고.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.LOWHP.T3.0.A": "꺼지지 마! 내 빛이 닿는 곳에 있어야 해!",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.LOWHP.T3.0.B": "...여기 있어. 안 꺼져.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.UPGRADE.T3.0.A": "이제 알겠어. 내가 빛나는 이유는 너야.",
  "MAGICSWORDSMAN-SWORD_TALK.CLAIOMHSOLAIS.UPGRADE.T3.0.B": "그 말은 좀 부끄럽다.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T0.0.A": "하하! 좁다, 좁아! 휘두를 자리가 없잖나!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T0.0.B": "적당히 커져.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T0.1.A": "한 놈뿐인가? 시시하군.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T0.1.B": "많으면 더 힘들어.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.COMBATSTART.T0.0.A": "언덕 셋을 벤 칼이다. 저 정도는 우습지.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.COMBATSTART.T0.0.B": "자만하지 마.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.VICTORY.T0.0.A": "다 쓸어 버렸군! 하하하!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.VICTORY.T0.0.B": "목소리 좀 낮춰.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.REST.T0.0.A": "요정 언덕의 불은 더 컸지.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.REST.T0.0.B": "여긴 작아도 따뜻해.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.LOWHP.T0.0.A": "이봐, 네가 쓰러지면 날 누가 드나!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.LOWHP.T0.0.B": "나 말고는 아무도 못 들어.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.UPGRADE.T0.0.A": "더 크게! 하늘을 가를 만큼!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.UPGRADE.T0.0.B": "그러다 만검총에 안 들어가.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T1.0.A": "왔구나! 오늘은 몇 놈이냐?",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T1.0.B": "직접 세어 봐.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T1.1.A": "세 놈까진 한 번에 벤다. 그 이상은 두 번!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T1.1.B": "든든하다.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.COMBATSTART.T1.0.A": "페르구스는 성질이 급했지. 넌 좀 낫군.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.COMBATSTART.T1.0.B": "칭찬이지?",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.VICTORY.T1.0.A": "후련하다! 이 맛에 싸우지!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.VICTORY.T1.0.B": "넌 싸울 때가 제일 신나 보여.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.REST.T1.0.A": "쉬는 것도 나쁘지 않군. 크게 휘두르려면 크게 쉬어야지.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.REST.T1.0.B": "맞는 말이야.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.LOWHP.T1.0.A": "물러서! 내가 크게 한 번 휘둘러 주마!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.LOWHP.T1.0.B": "부탁해!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.UPGRADE.T1.0.A": "칼날이 단단해졌다! 레테가 봤다면 놀랐겠군.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.UPGRADE.T1.0.B": "레테가 누군데?",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T2.0.A": "엔시페르! 널 위해서라면 언덕 열 개도 벤다!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T2.0.B": "셋이면 충분해.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T2.1.A": "적이 하나여도 괜찮다. 너랑 싸우면 즐거우니까.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T2.1.B": "많이 변했네.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.COMBATSTART.T2.0.A": "자, 크게 가 보자고!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.COMBATSTART.T2.0.B": "그래, 크게!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.VICTORY.T2.0.A": "하하! 네 손도 내 크기에 익숙해졌구나!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.VICTORY.T2.0.B": "무겁긴 하지만.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.REST.T2.0.A": "요정 언덕보다 여기가 좋다. 시끄러운 건 나 하나니까.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.REST.T2.0.B": "그건 맞아.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.LOWHP.T2.0.A": "누가 감히! 저놈들 다 쓸어 버리자!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.LOWHP.T2.0.B": "같이 가자, 칼라드볼그!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.UPGRADE.T2.0.A": "이번엔 정말 하늘이 갈라질지도 모르겠군!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.UPGRADE.T2.0.B": "가르지는 마.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T3.0.A": "형님이라 불러도 좋다! ...아니, 친구로 하자.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T3.0.B": "친구가 좋아.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T3.1.A": "언덕 셋을 벤 날보다 오늘이 더 설렌다!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.SUMMON.T3.1.B": "나도.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.COMBATSTART.T3.0.A": "몇 놈이든 상관없다. 네 앞길은 내가 쓸어 주마.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.COMBATSTART.T3.0.B": "든든하다, 친구.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.VICTORY.T3.0.A": "우리가 이겼다! 크게 웃어라, 엔시페르!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.VICTORY.T3.0.B": "하하... 이렇게?",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.REST.T3.0.A": "오늘은 조용히 있어 주마. 네가 자는 동안만.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.REST.T3.0.B": "고마워. 진짜 조용히야.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.LOWHP.T3.0.A": "너를 쓰러뜨리는 놈은 언덕째로 날려 버린다!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.LOWHP.T3.0.B": "...그래, 같이 날려 버리자.",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.UPGRADE.T3.0.A": "하늘을 가르는 칼날, 너에게 맡긴다!",
  "MAGICSWORDSMAN-SWORD_TALK.CALADBOLG.UPGRADE.T3.0.B": "잘 쓸게."
}