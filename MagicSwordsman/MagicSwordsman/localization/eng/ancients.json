{
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0r.char": "Is there a sleeping blade at the top of this spire too?",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0r.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1r.ancient": "Gravekeeper. Blades do not sleep. They only wait for their next grave. You.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-attack": "Both",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.ancient": "...Another child weighed down with blades.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.char": "I'm not carrying them. I'm keeping them locked away.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-2.ancient": "Poor thing. Then take one of my blessings, too.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.ancient": "You've woken again. The blades in your tomb were noisy.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.char": "Sorry. I'll calm them down.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "No matter how often you fall, you return, little warden.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "There are still blades out there.",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.next": "Continue",
  "NEOW.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-2.ancient": "...Then rise once more.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.ancient": "Oho, a collector of blades? I'm a collector myself.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.char": "I don't collect them. I seal them.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-2.ancient": "Same thing. Now, pick one of my treasures.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.ancient": "That tomb of yours—does it hold anything besides blades?",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.char": "No. Blades only.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "Back again. Trade me one blade for one treasure?",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "Absolutely not.",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.next": "Continue",
  "DARV.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-2.ancient": "Tch. Fine, just take one.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.ancient": "You carry a tomb with you. Heavy, like deep water.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.char": "I'm used to it.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-2.ancient": "If I touch it, that door might open a little.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.ancient": "Between the waves, I hear your blades weeping.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.char": "Let them. They're wicked blades.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "Like glass worn by the tide, you've grown smoother.",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "OROBAS.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "Maybe. Thanks to the blades.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.ancient": "So many blades. Could they cut my flesh?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.char": "I have no intention to.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-2.ancient": "A pity. Then I'll just tear some off for you.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.ancient": "Is there room in your tomb for one of my teeth?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.char": "Blades only, I said.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "You came back. Which part shall I give you this time?",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "...Any. Somewhere that won't hurt.",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.next": "Continue",
  "PAEL.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-2.ancient": "How kind, warden.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.ancient": "Oh my, carrying so much cold steel? Your hands must be freezing.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.char": "...A little.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-2.ancient": "Come here. I'll give you something warm.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.ancient": "Are you eating properly? Not just polishing swords?",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.char": "...Everyone keeps asking that.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "There's my little warden. Are your blades behaving?",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "Sometimes. They talk to me now.",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.next": "Continue",
  "TEZCATARA.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-2.ancient": "That's a good sign, dear.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.ancient": "Oh my, those blades! They could use more ornament.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.char": "No decorating. The curses wake up.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-2.ancient": "Beauty is stronger than any curse.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.ancient": "A golden hilt, a blade set with relics... you have taste.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.char": "I didn't choose them. I sealed them.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "Your blades sparkle, yet you look so plain.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "A warden shouldn't stand out.",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.next": "Continue",
  "NONUPEIPE.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-2.ancient": "Hmph. At least wear this.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.ancient": "Hahaha! Blades! The smell of steel is everywhere!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.char": "Don't touch. They're dangerous.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-2.ancient": "That's what makes them good!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.ancient": "Show me the strongest of your blades!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.char": "They're all strong. And no.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "Kid! With that many blades, surely you can spare me one!",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "No. But I'll take one of your weapons.",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.next": "Continue",
  "TANX.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-2.ancient": "Hahaha! You've got guts!",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.ancient": "A warden of cursed blades... how wonderfully tragic.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-0.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.char": "It's not tragic. It's just my job.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-1.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.0-2.ancient": "Heh. Your composure makes it lovelier still.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.ancient": "I'd love to hear those blades play. They'd sound like screams.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.char": "That's not what they're for.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "Back again, my little tragedy. Is your tomb not full yet?",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "Ten thousand is still a long way off.",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.next": "Continue",
  "VAKUU.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-2.ancient": "Then I shall watch until that day.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.char": "I climbed your spire again. Still no sleeping blade.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-0.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.ancient": "If you find nothing, why do you climb?",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-1.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-2.char": "Because there are still blades out there.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.1-attack": "Both",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.ancient": "Gravekeeper. The door behind you stands ajar.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-0.next": "Continue",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-1.char": "I know. Today I opened it myself.",
  "THE_ARCHITECT.talk.MAGICSWORDSMAN-MAGIC_SWORDSMAN_CHARACTER.2-attack": "Both"
}